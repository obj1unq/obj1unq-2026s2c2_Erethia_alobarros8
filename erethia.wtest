import rolando.*
describe "Erethia" {

      test "Rolando tiene la mochila vacía al inicio, recolecta espada y libro, pero ignora el collar por capacidad" {
    
    assert.equals([], rolando.mochila())

    
    rolando.encontrar(espadaDelDestino)
    assert.equals([espadaDelDestino], rolando.mochila())

    
    rolando.encontrar(libroDeHechizos)
    assert.equals([espadaDelDestino, libroDeHechizos], rolando.mochila())

    
    rolando.encontrar(collarDivino)
    
    
    assert.equals([espadaDelDestino, libroDeHechizos], rolando.mochila())
  }

  test "Se puede incrementar la capacidad de la mochila para poder recolectar más artefactos" {
    
    rolando.capacidadMochila(3)
    
    rolando.encontrar(espadaDelDestino)
    rolando.encontrar(libroDeHechizos)
    
    
    rolando.encontrar(collarDivino)
    
    assert.equals([espadaDelDestino, libroDeHechizos, collarDivino], rolando.mochila())
  }

   test "El Castillo de Piedra permite almacenar artefactos ilimitados liberando espacio en la mochila" {
    
    assert.equals([], rolando.mochila())
    assert.equals([], castilloDePiedra.baulCastillo())

    
    rolando.encontrar(espadaDelDestino)
    assert.equals([espadaDelDestino], rolando.mochila())

    
    rolando.encontrar(libroDeHechizos)
    assert.equals([espadaDelDestino, libroDeHechizos], rolando.mochila())

    
    rolando.llegarAHogar()
    
    
    assert.equals([], rolando.mochila())
    
    assert.equals([espadaDelDestino, libroDeHechizos], castilloDePiedra.baulCastillo())

    
    rolando.encontrar(collarDivino)
    assert.equals([collarDivino], rolando.mochila())

    
    rolando.llegarAHogar()

   
    assert.equals([], rolando.mochila())
    
    assert.equals([espadaDelDestino, libroDeHechizos, collarDivino], castilloDePiedra.baulCastillo())
  }

  test "Capacidad de la mochila se respeta antes de ir al castillo" {
    
    rolando.encontrar(espadaDelDestino)
    rolando.encontrar(libroDeHechizos)
   rolando.encontrar(collarDivino)  
    
    assert.equals([espadaDelDestino, libroDeHechizos], rolando.mochila())
  }

  test "Saber las posesiones totales de Rolando y si posee un artefacto en particular " {
  
    
   
    rolando.encontrar(collarDivino)
    rolando.encontrar(espadaDelDestino)
    rolando.llegarAHogar()
    
    rolando.encontrar(armaduraDeAceroValyrio)
    
    assert.equals(#{collarDivino, espadaDelDestino, armaduraDeAceroValyrio}, rolando.posesiones())

    assert.that(rolando.posee(collarDivino))
    assert.that(rolando.posee(espadaDelDestino))
    assert.that(rolando.posee(armaduraDeAceroValyrio))

    assert.notThat(rolando.posee(libroDeHechizos))
  }

   test "Historial de encuentros registra el orden cronológico exacto de encuentros, sin importar si los recolectó o no " {
   
    rolando.encontrar(espadaDelDestino)
    
    rolando.encontrar(libroDeHechizos)
    
    rolando.encontrar(collarDivino)
   
    rolando.llegarAHogar()
    
    rolando.encontrar(armaduraDeAceroValyrio)
    
    rolando.encontrar(collarDivino)
    
    const historialEsperado = [
      espadaDelDestino,
      libroDeHechizos,
      collarDivino,
      armaduraDeAceroValyrio,
      collarDivino
    ]
    
    assert.equals(historialEsperado, rolando.historialEncuentros())
  }

  test "Poder de batalla, calculamos el poder de batalla para la batalla" {
    /*- Hacer que Rolando tenga 5 de base y capacidad de 3 artefactos. Entre sus artefactos se encuentran la *espada* (que le aporta 5), la *armadura* (aporta 6) y el *collar* (aporta 3).
- Luego de la primer batalla Rolando tiene 6 de base, la espada (aporta 6/2 = 3), la armadura (aporta 6) y el collar (aporta 3)  
- Luego de la segunda batalla Rolando tiene 7 de base, la espada (aporta 7/2 = 3.5), la armadura 6 y el collar (3+2=5)
- Luego de la tercera batalla Rolando tiene 8 de base, la espada (aporta 8/2=4), la armadura 6 y el collar (3+3=6)*/
    rolando.poderBase(5)
    rolando.capacidadMochila(3)
    rolando.encontrar(espadaDelDestino)
    rolando.encontrar(collarDivino)
    rolando.encontrar(armaduraDeAceroValyrio)
    assert.equals(19, rolando.poderDeBatalla())
    rolando.batalla()
    assert.equals(6, rolando.poderBase())
    assert.equals(3, espadaDelDestino.poderDeBatalla(rolando))
    assert.equals(6, armaduraDeAceroValyrio.poderDeBatalla(rolando))
    assert.equals(3, collarDivino.poderDeBatalla(rolando))

    } 
      
}